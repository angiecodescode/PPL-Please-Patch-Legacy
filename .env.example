# Copy this file to .env and insert your real API keys.
# Never commit your .env file to GitHub!

# Primary Gemini API key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated backup Gemini API keys for automatic rate-limit rotation
# Example: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=

# Optional: free NVIDIA NIM API key (nvapi-...) from https://build.nvidia.com
# Unlocks the live catalog of free NVIDIA models as an Independent Agent 2 Code Reviewer
NVIDIA_API_KEY=